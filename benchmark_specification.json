  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --model-name bert-base-uncased --dtype f16_r --precision mixed_float16 --num-gpus 1 --prompt-source synthetic --sequence-len 32 --batch-size 1 --warmup-iters 2 --num-iterations 5"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
